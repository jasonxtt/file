[Unit]
Description=Natter mapping sync service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/natter-sync/natter-sync.env
ExecStart=/usr/bin/python3 /opt/natter/natter_sync.py
Restart=always
RestartSec=5
User=root
WorkingDirectory=/opt/natter

[Install]
WantedBy=multi-user.target
